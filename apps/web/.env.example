# Recommended: leave NEXT_PUBLIC_API_URL unset — the UI calls /api (proxied to 127.0.0.1:4001).
# NEXT_PUBLIC_API_URL=
# If you set it explicitly, use port 4001 (NOT 3000/3001):
# NEXT_PUBLIC_API_URL=http://127.0.0.1:4001
NEXT_PUBLIC_API_KEY=dev-local-key
# Must match REVIEWER_KEYS on the API (key portion before first colon)
NEXT_PUBLIC_REVIEWER_API_KEY=reviewer-dev-key
