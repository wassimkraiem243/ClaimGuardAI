DATABASE_URL=postgresql+psycopg://claimguard:claimguard@localhost:5433/claimguard
API_KEY=dev-local-key
# Reviewer HITL: key:actor:role (role reviewer|admin), comma-separated
REVIEWER_KEYS=reviewer-dev-key:demo.reviewer:reviewer
CLAIMGUARD_JWT_SECRET=change-me-to-at-least-32-random-characters-long
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
PORT=4001

# Rule engine (defaults: repo data/payer-rules, outputs/audit.jsonl)
# RULES_DIR=
AUDIT_ENABLED=true
# AUDIT_LOG_PATH=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text
